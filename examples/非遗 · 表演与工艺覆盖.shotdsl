shotdsl 0.1

scene heritage_mask_performance_coverage {
  duration 11s
  fps 30
  seed 2368
  style cinematic-outline
}

actor artisan {
  model "human-mannequin"
  color ivory
  position [-2.2m, 0m, 0.5m]
  rotation [0deg, 55deg, 0deg]
}

actor performer {
  model "human-mannequin"
  color #c94f44
  position [1.8m, 0m, -0.3m]
  rotation [0deg, -35deg, 0deg]
}

object courtyard {
  primitive box
  size [12m, 0.1m, 8m]
  color #8c8576
  position [0m, 0.05m, 0m]
}

object village_wall {
  primitive box
  size [12m, 2.5m, 0.18m]
  color #b7ab92
  position [0m, 1.25m, -3.7m]
}

object old_tree {
  primitive cylinder
  radius 0.28m
  height 3.6m
  color #604831
  position [-4.4m, 1.8m, -1.4m]
}

object tree_crown {
  primitive sphere
  radius 1.65m
  color #5d7453
  position [-4.4m, 3.8m, -1.4m]
}

object workbench {
  primitive box
  size [2.2m, 0.78m, 1.1m]
  color #6a4c34
  position [-1.7m, 0.78m, 0.8m]
}

object carved_mask {
  primitive sphere
  radius 0.32m
  color #d64f39
  position [-1.65m, 1.2m, 0.8m]
  scale [0.8, 1.15, 0.35]
}

object carving_tool {
  primitive box
  size [0.42m, 0.035m, 0.035m]
  color #c2b9a7
  position [-2.05m, 1.2m, 0.78m]
  rotation [0deg, 22deg, 0deg]
}

object drum {
  primitive cylinder
  radius 0.48m
  height 0.5m
  color #8e372f
  position [3.55m, 0.5m, -1.4m]
  rotation [90deg, 0deg, 0deg]
}

camera landscape_master {
  mode lookAt
  fov 44deg
  position [0m, 3.6m, 8.5m]
  target point [0m, 1m, -0.2m]
}

camera craft_medium {
  mode lookAt
  fov 34deg
  position [-3.8m, 1.7m, 3.2m]
  target actor artisan bone "head"
}

camera tool_insert {
  mode lookAt
  fov 22deg
  position [-1.6m, 1.65m, 1.8m]
  target object carved_mask
}

camera artisan_portrait {
  mode follow
  fov 29deg
  target actor artisan bone "head"
  offset [-0.45m, 0.08m, 1.8m]
}

camera dance_orbit {
  mode orbit
  fov 38deg
  target actor performer
  radius 4.6m
  azimuth -32deg
  elevation 13deg
}

camera mask_hero {
  mode lookAt
  fov 25deg
  position [-0.8m, 1.5m, 1.7m]
  target object carved_mask
}

beat craft_detail {
  from 0s
  to 4.2s
  intent "从环境建立进入手艺人中景和工具特写，让制作动作具有清楚的空间归属"
  emotion "专注、安静"
  focus object carved_mask
  continuity preserve
}

beat maker_portrait {
  from 4.2s
  to 6s
  intent "从作品回到手艺人面部，建立作品与人物的因果关系"
  emotion "克制的自豪"
  focus actor artisan bone "head"
  continuity preserve
}

beat performance_release {
  from 6s
  to 11s
  intent "由静态制作切入舞者全身动作，用环绕镜头释放节奏并以面具英雄镜头结束"
  emotion "明亮、昂扬"
  focus actor performer
  continuity reset
}

workflow professional_previs {
  approval manual
  failure stop
  dispatch previs.asset-supervisor as assets scope scene mode review
  dispatch previs.blocking-director as staging scope beat:craft_detail mode propose after assets
  dispatch previs.action-choreographer as performance scope timeline mode propose after staging
  dispatch previs.cinematographer as coverage scope beat:performance_release mode propose after staging
  dispatch previs.continuity-supervisor as continuity scope scene mode review after performance,coverage
  dispatch previs.qc as final_qc scope scene mode review after continuity
}

timeline {
  cut 0s camera landscape_master
  play 0s actor artisan clip "idle" loop true
  play 0s actor performer clip "idle" loop true
  gaze 0s actor artisan target object carved_mask duration 6s strength 0.9

  cut 1.2s camera craft_medium
  play 1.3s actor artisan clip "reach" loop true blend 0.14s
  cut 2.5s camera tool_insert
  key 2.5s carving_tool.rotation [0deg, 22deg, 0deg]
  key 3.7s carving_tool.rotation [0deg, -18deg, 12deg] ease smoothstep
  key 2.5s carved_mask.rotation [0deg, 0deg, 0deg]
  key 3.7s carved_mask.rotation [0deg, 18deg, 0deg] ease smoothstep

  cut 4.2s camera artisan_portrait
  play 4.25s actor artisan clip "idle" loop true blend 0.14s
  play 4.5s actor artisan clip "talk" loop true blend 0.16s
  cut 6s camera landscape_master
  play 6s actor artisan clip "idle" loop true blend 0.14s
  play 6.05s actor performer clip "dance" loop true blend 0.18s

  cut 7.1s camera dance_orbit
  key 7.1s dance_orbit.azimuth -32deg
  key 9.6s dance_orbit.azimuth 28deg ease smoothstep
  cut 9.7s camera mask_hero
  key 9.7s carved_mask.rotation [0deg, 18deg, 0deg]
  key 11s carved_mask.rotation [0deg, 55deg, 0deg] ease smoothstep
}
