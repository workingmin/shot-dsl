shotdsl 0.1

scene rainy_window_suspense {
  duration 8.5s
  fps 30
  seed 8834
  style wireframe
}

actor person_d {
  model "generic_female"
  color white
  position [0m, 0m, -0.15m]
  rotation [0deg, 0deg, 0deg]
}

object photo_prop {
  primitive box
  size [0.15m, 0.2m, 0.002m]
  color lightgray
  position [0.35m, 0.86m, 0.3m]
  rotation [0deg, 8deg, 0deg]
}

object side_table {
  primitive box
  size [1.1m, 0.72m, 0.7m]
  color #3f4448
  position [0.35m, 0.36m, 0.25m]
}

object window_frame {
  primitive box
  size [3m, 2.4m, 0.12m]
  color darkslategray
  position [0m, 1.2m, -2.2m]
}

camera cam_ecu {
  mode lookAt
  fov 22deg
  position [0.85m, 1.05m, 1.15m]
  target object photo_prop
  roll 0deg
}

camera cam_close {
  mode lookAt
  fov 32deg
  position [1.35m, 1.5m, 2.1m]
  target actor person_d bone "head"
  roll 0deg
}

camera cam_wide_dolly {
  mode lookAt
  fov 50deg
  position [2.4m, 1.65m, 3.6m]
  target point [0m, 1.3m, 0m]
  roll 0deg
}

timeline {
  # 雨声与低沉悬疑音乐
  cut 0s camera cam_ecu
  play 0s actor person_d clip "idle" loop true

  cut 1.7s camera cam_close
  key 1.7s cam_close.position [1.35m, 1.5m, 2.1m]
  key 4.7s cam_close.position [0.95m, 1.48m, 1.55m] ease smoothstep
  play 1.7s actor person_d clip "look" loop true blend 0.2s
  gaze 1.7s actor person_d target object photo_prop duration 3s strength 0.9

  # 从人物情绪切回环境关系，短促拉远结束
  cut 4.7s camera cam_wide_dolly
  key 4.7s cam_wide_dolly.position [2.4m, 1.65m, 3.6m]
  key 8.5s cam_wide_dolly.position [4.4m, 2m, 6.2m] ease smoothstep
  play 4.9s actor person_d clip "idle" loop true blend 0.2s
}
