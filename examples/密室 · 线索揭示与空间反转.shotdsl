shotdsl 0.1

scene chamber_clue_reveal {
  duration 9s
  fps 24
  seed 331
  style storyboard
}

actor investigator {
  model "storyboard-mannequin"
  position [-2m, 0m, 0.5m]
  rotation [0deg, 70deg, 0deg]
}

actor assistant {
  model "storyboard-mannequin"
  position [1.4m, 0m, 1.5m]
  rotation [0deg, -120deg, 0deg]
}

object table {
  primitive box
  size [2.4m, 0.8m, 1.2m]
  position [0m, 0.8m, 0m]
}

object clue {
  primitive box
  size [0.3m, 0.03m, 0.2m]
  position [0.3m, 1.22m, 0m]
}

object hidden_door {
  primitive box
  size [1.4m, 2.4m, 0.14m]
  position [3m, 1.2m, -2.8m]
  rotation [0deg, -18deg, 0deg]
}

camera chamber_master {
  mode lookAt
  fov 43deg
  position [0m, 3m, 7m]
  target point [0m, 1m, 0m]
}

camera clue_insert {
  mode lookAt
  fov 23deg
  position [0.8m, 1.7m, 1.8m]
  target object clue
}

camera assistant_reverse {
  mode lookAt
  fov 34deg
  position [3.6m, 1.8m, 2.2m]
  target actor assistant bone "head"
}

camera overhead_reveal {
  mode lookAt
  fov 47deg
  position [0.8m, 8m, 0.4m]
  target point [0.5m, 0m, -0.5m]
}

beat search {
  from 0s
  to 3s
  intent "建立密室、桌面和两人站位"
  focus actor investigator
  continuity preserve
}

beat clue_found {
  from 3s
  to 6s
  intent "切线索特写并用视线确认发现"
  focus object clue
  continuity preserve
}

beat spatial_reveal {
  from 6s
  to 9s
  intent "反打后升到俯视，揭示隐藏门与原有站位的关系"
  focus object hidden_door
  continuity preserve
}

timeline {
  cut 0s camera chamber_master
  note 0s "全景：先交代桌面、人物和后墙" duration 1.8s
  play 0s actor investigator clip "look-around" loop true
  play 0s actor assistant clip "idle" loop true
  key 0s investigator.position [-2m, 0m, 0.5m]
  key 2.8s investigator.position [-0.8m, 0m, 0.2m] ease smoothstep

  cut 3s camera clue_insert
  note 3s "线索特写，动作与走位在此停顿" duration 1.8s
  play 3s actor investigator clip "idle" loop true blend 0.12s
  play 3.2s actor investigator clip "reach" loop false blend 0.12s
  gaze 3s actor investigator target object clue duration 3s strength 0.9
  gaze 3.2s actor assistant target object clue duration 2.8s strength 0.75
  ik 3.2s actor investigator effector "hand_r" target object clue weight 0.65 duration 0.8s

  cut 5.4s camera assistant_reverse
  note 5.4s "反打：助手看向画面外的隐藏门" duration 1.5s
  gaze 5.4s actor assistant target object hidden_door duration 3.6s strength 0.9
  cut 6.8s camera overhead_reveal
  note 6.8s "升到俯视，揭示隐藏门与人物站位" duration 2.2s
  key 6.8s overhead_reveal.position [0.8m, 8m, 0.4m]
  key 9s overhead_reveal.position [1.4m, 9m, -0.2m] ease smoothstep
}
