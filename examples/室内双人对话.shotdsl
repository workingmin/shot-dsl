shotdsl 0.1

scene office_dialogue {
  duration 12s
  fps 30
  seed 4127
  style wireframe
}

actor man_a {
  model "generic_male_business"
  color white
  position [0m, 0m, 0m]
  rotation [0deg, 180deg, 0deg]
}

actor woman_b {
  model "generic_female_business"
  color lightgray
  position [2.2m, 0m, 0m]
  rotation [0deg, 180deg, 0deg]
}

object desk {
  primitive box
  size [2.4m, 0.75m, 1.2m]
  color darkslategray
  position [0m, 0.375m, 0.6m]
}

object room_bg {
  primitive box
  size [12m, 3m, 8m]
  color slategray
  position [0m, 1.5m, -4m]
}

camera cam_med {
  mode lookAt
  fov 40deg
  position [-6m, 1.6m, 3m]
  target point [0m, 1.2m, 0m]
  roll 0deg
}

camera cam_ots {
  mode lookAt
  fov 35deg
  position [1.8m, 1.55m, 0.8m]
  target actor man_a bone "head"
  roll 0deg
}

camera cam_med_dolly {
  mode lookAt
  fov 42deg
  position [-4.5m, 1.6m, 2.2m]
  target point [1.1m, 1.2m, 0m]
  roll 0deg
}

timeline {
  # 办公室环境底噪
  cut 0s camera cam_med
  play 0s actor man_a clip "idle" loop true
  play 0s actor woman_b clip "idle" loop true

  # B：“为什么？”
  cut 4s camera cam_ots
  play 4s actor woman_b clip "talk" loop false blend 0.2s

  # A：“这是你的任命书。”
  cut 8s camera cam_med_dolly
  key 8s cam_med_dolly.position [-4.5m, 1.6m, 2.2m]
  key 12s cam_med_dolly.position [-6.2m, 1.6m, 3.4m] ease smoothstep
  play 8.2s actor man_a clip "reach" loop false blend 0.2s
}
