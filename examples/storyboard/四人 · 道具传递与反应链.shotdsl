shotdsl 0.1

scene four_actor_prop_handoff {
  duration 10s
  fps 24
  seed 901
  style storyboard
}

actor sender {
  model "storyboard-mannequin"
  position [-2.2m, 0m, 0m]
  rotation [0deg, 90deg, 0deg]
}

actor receiver {
  model "storyboard-mannequin"
  position [0m, 0m, 0m]
  rotation [0deg, -90deg, 0deg]
}

actor observer_left {
  model "storyboard-mannequin"
  position [-1.8m, 0m, -2m]
}

actor observer_right {
  model "storyboard-mannequin"
  position [1.8m, 0m, -2m]
}

object envelope {
  primitive box
  size [0.28m, 0.04m, 0.18m]
  position [-1.8m, 1m, 0m]
}

camera group_master {
  mode lookAt
  fov 45deg
  position [0m, 2.8m, 7m]
  target point [0m, 1m, -0.5m]
}

camera handoff_insert {
  mode lookAt
  fov 27deg
  position [-0.8m, 1.5m, 2m]
  target object envelope
}

camera receiver_close {
  mode follow
  fov 32deg
  target actor receiver bone "head"
  offset [0.4m, 0.1m, 2.1m]
}

camera group_orbit {
  mode orbit
  fov 43deg
  target actor receiver
  radius 6m
  azimuth -30deg
  elevation 18deg
}

beat prepare {
  from 0s
  to 3s
  intent "全景交代四人站位和传递方向"
  focus object envelope
  continuity preserve
}

beat handoff {
  from 3s
  to 6.5s
  intent "用手部特写表达道具从发送者转移到接收者"
  focus object envelope
  continuity preserve
}

beat reaction {
  from 6.5s
  to 10s
  intent "接收者查看道具，旁观者视线形成反应链"
  focus actor receiver
  continuity preserve
}

timeline {
  cut 0s camera group_master
  note 0s "全景：四人站位和道具传递方向" duration 2s
  play 0s actor sender clip "idle" loop true
  play 0s actor receiver clip "idle" loop true
  play 0s actor observer_left clip "idle" loop true
  play 0s actor observer_right clip "idle" loop true
  gaze 0s actor observer_left target object envelope duration 10s strength 0.65
  gaze 0s actor observer_right target object envelope duration 10s strength 0.65

  play 2.8s actor sender clip "reach" loop false blend 0.12s
  cut 3s camera handoff_insert
  note 3s "特写：道具在两人之间完成交接" duration 2.4s
  attach 3s object envelope to actor sender bone "hand_r" offset [0m, 0m, 0.08m] release 1.5s
  ik 3s actor receiver effector "hand_r" target object envelope weight 0.7 duration 1.4s
  play 3.2s actor receiver clip "reach" loop false blend 0.12s
  attach 4.6s object envelope to actor receiver bone "hand_r" offset [0m, 0m, 0.08m]

  cut 6.5s camera receiver_close
  note 6.5s "接收者停顿查看，旁观者视线跟随" duration 2s
  gaze 6.5s actor receiver target object envelope duration 3.5s strength 0.9
  gaze 6.5s actor observer_left target actor receiver bone "head" duration 3.5s strength 0.8
  gaze 6.5s actor observer_right target actor receiver bone "head" duration 3.5s strength 0.8
  cut 8.4s camera group_orbit
  key 8.4s group_orbit.azimuth -30deg
  key 10s group_orbit.azimuth 10deg ease smoothstep
}
