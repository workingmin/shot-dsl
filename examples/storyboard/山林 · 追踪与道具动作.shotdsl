shotdsl 0.1

scene forest_tracking_blocking {
  duration 10s
  fps 24
  seed 4207
  style storyboard
}

actor scout {
  model "storyboard-mannequin"
  position [-4m, 0m, 0.5m]
  rotation [0deg, 90deg, 0deg]
}

actor partner {
  model "storyboard-mannequin"
  position [-5m, 0m, -0.8m]
  rotation [0deg, 90deg, 0deg]
}

object trail_marker {
  primitive cylinder
  radius 0.16m
  height 0.05m
  position [0.8m, 0.05m, 0.7m]
}

object tree_left {
  primitive cylinder
  radius 0.3m
  height 4m
  position [-2m, 2m, -2.5m]
}

object tree_right {
  primitive cylinder
  radius 0.34m
  height 4.4m
  position [2.7m, 2.2m, -2.8m]
}

camera establish {
  mode lookAt
  fov 46deg
  position [0m, 3m, 8m]
  target point [0m, 1m, 0m]
}

camera follow_pair {
  mode follow
  fov 38deg
  target actor scout bone "head"
  offset [-2.8m, 0.5m, 3.2m]
}

camera marker_insert {
  mode lookAt
  fov 24deg
  position [1.4m, 1.1m, 1.8m]
  target object trail_marker
}

camera exit_orbit {
  mode orbit
  fov 42deg
  target actor scout
  radius 5.5m
  azimuth -25deg
  elevation 14deg
}

beat approach {
  from 0s
  to 4.5s
  intent "建立路径方向，并跟随两人从画面左侧走向标记物"
  focus actor scout
  continuity preserve
  notes "人物只需表达走位和观察方向"
}

beat discover {
  from 4.5s
  to 7s
  intent "停止移动，切标记物特写，再回到人物确认"
  focus object trail_marker
  continuity preserve
}

beat leave {
  from 7s
  to 10s
  intent "两人继续向右前方移动，环绕镜头重新交代空间"
  focus actor scout
  continuity preserve
}

timeline {
  cut 0s camera establish
  note 0s "全景建立路径和人物起点" duration 1.8s
  play 0s actor scout clip "walk" loop true
  play 0s actor partner clip "walk" loop true
  key 0s scout.position [-4m, 0m, 0.5m]
  key 4.2s scout.position [0m, 0m, 0.5m] ease smoothstep
  key 0s partner.position [-5m, 0m, -0.8m]
  key 4.4s partner.position [-1m, 0m, -0.8m] ease smoothstep

  cut 1.6s camera follow_pair
  note 1.6s "跟拍：保持两人前进方向从左到右" duration 2.2s
  cut 4.5s camera marker_insert
  note 4.5s "动作停顿，切道具特写" duration 1.8s
  play 4.4s actor scout clip "idle" loop true blend 0.16s
  play 4.5s actor partner clip "idle" loop true blend 0.16s
  gaze 4.4s actor scout target object trail_marker duration 2.5s strength 0.9
  gaze 4.5s actor partner target object trail_marker duration 2.4s strength 0.8
  play 5s actor scout clip "reach" loop false blend 0.12s
  ik 5s actor scout effector "hand_r" target object trail_marker weight 0.65 duration 0.8s

  cut 6.2s camera follow_pair
  note 6.2s "回到人物，确认线索后继续移动" duration 1.4s
  cut 7.2s camera exit_orbit
  play 7.1s actor scout clip "walk" loop true blend 0.16s
  play 7.2s actor partner clip "walk" loop true blend 0.16s
  key 7.1s scout.position [0m, 0m, 0.5m]
  key 10s scout.position [4.2m, 0m, 0.5m] ease smoothstep
  key 7.2s partner.position [-1m, 0m, -0.8m]
  key 10s partner.position [3.2m, 0m, -0.8m] ease smoothstep
  key 7.2s exit_orbit.azimuth -25deg
  key 10s exit_orbit.azimuth 18deg ease smoothstep
}
