shotdsl 0.1

scene courtyard_dusk_dialogue {
  duration 10s
  fps 30
  seed 8426
  style cinematic-outline
}

actor elder {
  model "generic_old_male"
  color ivory
  position [-3m, 0m, 0.8m]
  rotation [0deg, 90deg, 0deg]
}

actor youth {
  model "generic_teen_male"
  color tan
  position [1.25m, 0m, 0.8m]
  rotation [0deg, -90deg, 0deg]
}

object ground {
  primitive box
  size [11m, 0.08m, 9m]
  color #8a7b64
  position [0m, 0.04m, 0m]
}

object wall_back {
  primitive box
  size [11m, 2.8m, 0.15m]
  color #c4b295
  position [0m, 1.4m, -4.4m]
}

object stone_table {
  primitive cylinder
  radius 0.65m
  height 0.72m
  color #707070
  position [0m, 0.36m, 0.8m]
}

object tree_trunk {
  primitive cylinder
  radius 0.2m
  height 2.5m
  color #5c442a
  position [-3m, 1.25m, 2.6m]
}

object tree_canopy {
  primitive sphere
  radius 1.7m
  color #3a5a3a
  position [-3m, 3m, 2.6m]
}

object lantern {
  primitive cylinder
  radius 0.14m
  height 0.42m
  color #e8c860
  position [3.4m, 1.8m, 0.8m]
}

object lantern_post {
  primitive cylinder
  radius 0.045m
  height 3.2m
  color #5c442a
  position [3.4m, 1.6m, 0.8m]
}

camera crane_wide {
  mode lookAt
  fov 42deg
  position [0m, 4.8m, 7.2m]
  target point [0m, 0.9m, 0.7m]
  roll -0.5deg
}

camera two_shot {
  mode lookAt
  fov 38deg
  position [0m, 1.7m, 4.6m]
  target point [0m, 1.05m, 0.8m]
}

camera elder_close {
  mode lookAt
  fov 32deg
  position [0.8m, 1.55m, 2.4m]
  target actor elder bone "head"
}

camera youth_close {
  mode lookAt
  fov 32deg
  position [-0.75m, 1.55m, 2.35m]
  target actor youth bone "head"
}

camera final_pull {
  mode lookAt
  fov 46deg
  position [0m, 2.2m, 5.2m]
  target point [0m, 1m, 0.8m]
}

timeline {
  # 长者入画，青年以视线承接运动方向
  cut 0s camera crane_wide
  play 0s actor elder clip "walk" loop true
  play 0s actor youth clip "idle" loop true
  gaze 0s actor youth target actor elder bone "head" duration 3s strength 0.8
  key 0s elder.position [-3m, 0m, 0.8m]
  key 2.2s elder.position [-1.25m, 0m, 0.8m] ease smoothstep
  key 0s crane_wide.position [0m, 4.8m, 7.2m]
  key 2.2s crane_wide.position [0m, 4m, 6.5m] ease smoothstep

  cut 2.2s camera two_shot
  play 2.2s actor elder clip "idle" loop true blend 0.2s
  gaze 2.2s actor elder target actor youth bone "head" duration 5.8s strength 0.8

  # 长者：“世事如流水。”
  cut 3s camera elder_close
  play 3s actor elder clip "talk" loop true blend 0.18s

  # 青年沉默回应，保留反应镜头而非连续炫技机位
  cut 5.2s camera youth_close
  play 5.2s actor elder clip "idle" loop true blend 0.18s
  play 5.2s actor youth clip "look-around" loop false blend 0.18s
  gaze 5.2s actor youth target actor elder bone "head" duration 2.8s strength 0.9

  cut 7.3s camera two_shot
  play 7.3s actor elder clip "reach" loop false blend 0.16s

  # 黄昏环境收束，缓慢拉远
  cut 8.2s camera final_pull
  play 8.2s actor elder clip "idle" loop true blend 0.18s
  key 8.2s final_pull.position [0m, 2.2m, 5.2m]
  key 10s final_pull.position [0m, 3.2m, 7m] ease smoothstep
}
