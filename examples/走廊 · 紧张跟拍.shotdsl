shotdsl 0.1

scene corridor_urgent_tracking {
  duration 8.5s
  fps 30
  seed 6157
  style cinematic
}

actor courier {
  model "game-ready-soldier"
  color white
  position [0m, 0m, -5m]
  rotation [0deg, 180deg, 0deg]
}

actor passerby_left {
  model "human-mannequin"
  color darkgray
  position [-1.45m, 0m, -0.5m]
  rotation [0deg, 90deg, 0deg]
}

actor passerby_right {
  model "human-mannequin"
  color tan
  position [1.4m, 0m, 2.2m]
  rotation [0deg, -90deg, 0deg]
}

object corridor_floor {
  primitive box
  size [5m, 0.08m, 16m]
  color #60666b
  position [0m, 0.04m, 0m]
}

object wall_left {
  primitive box
  size [0.1m, 3.2m, 16m]
  color #9a9ea3
  position [-2.55m, 1.6m, 0m]
}

object wall_right {
  primitive box
  size [0.1m, 3.2m, 16m]
  color #9a9ea3
  position [2.55m, 1.6m, 0m]
}

object ceiling {
  primitive box
  size [5m, 0.08m, 16m]
  color #777d82
  position [0m, 3.2m, 0m]
}

object door_left {
  primitive box
  size [0.06m, 2.2m, 1.1m]
  color #6b5030
  position [-2.49m, 1.1m, 1.8m]
}

camera establish {
  mode lookAt
  fov 40deg
  position [0m, 2.2m, 7.5m]
  target point [0m, 1m, -2.5m]
}

camera front_track {
  mode follow
  fov 42deg
  target actor courier bone "head"
  offset [0m, 0.25m, 3.1m]
  shake 0.012m
}

camera side_track {
  mode follow
  fov 38deg
  target actor courier bone "head"
  offset [-3m, 0.15m, 0.8m]
  shake 0.018m
  roll -1deg
}

camera low_rear {
  mode follow
  fov 45deg
  target actor courier bone "head"
  offset [0m, -0.5m, -2.7m]
  shake 0.028m
}

camera stop_close {
  mode lookAt
  fov 28deg
  position [0.8m, 1.55m, 8m]
  target point [0m, 1.55m, 5.2m]
}

timeline {
  # 先用纵深建立人物方向，再进入运动镜头
  cut 0s camera establish
  play 0s actor courier clip "walk" loop true
  play 0s actor passerby_left clip "idle" loop true
  play 0s actor passerby_right clip "idle" loop true
  key 0s courier.position [0m, 0m, -5m]
  key 2.2s courier.position [0m, 0m, -2.2m] ease smoothstep

  cut 1.2s camera front_track
  key 1.2s front_track.offset [0m, 0.25m, 3.1m]
  key 3s front_track.offset [0m, 0.2m, 2.7m] ease smoothstep

  # 加速从路人之间穿过
  play 2.2s actor courier clip "run" loop true speed 1.05 blend 0.18s
  key 5.8s courier.position [0m, 0m, 4m] ease smoothstep
  cut 3s camera side_track
  play 3.1s actor passerby_left clip "look-around" loop true blend 0.2s
  gaze 3.1s actor passerby_left target actor courier bone "head" duration 2.2s strength 0.8
  play 4.1s actor passerby_right clip "look-around" loop true blend 0.2s
  gaze 4.1s actor passerby_right target actor courier bone "head" duration 2s strength 0.8

  # 短暂后跟强化速度，不延长为单调长镜头
  cut 4.6s camera low_rear
  key 6.7s courier.position [0m, 0m, 5.2m] ease smoothstep

  # 到点急停，以长焦近景结束
  cut 6.45s camera stop_close
  play 6.65s actor courier clip "idle" loop true blend 0.2s
  key 8.5s courier.position [0m, 0m, 5.2m] ease hold
}
