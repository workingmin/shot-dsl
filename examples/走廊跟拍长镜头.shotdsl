shotdsl 0.1

scene corridor_follow_long_take {
  duration 10s
  fps 30
  seed 5219
  style 3d_cinematic_wireframe
}

actor person_c {
  model "generic_young_male"
  color white
  position [0m, 0m, 0m]
  rotation [0deg, 0deg, 0deg]
}

object corridor_floor {
  primitive box
  size [3m, 0.1m, 14m]
  color darkslategray
  position [0m, 0.05m, 6m]
}

object wall_left {
  primitive box
  size [0.2m, 2.8m, 14m]
  color dimgray
  position [-1.5m, 1.4m, 6m]
}

object wall_right {
  primitive box
  size [0.2m, 2.8m, 14m]
  color dimgray
  position [1.5m, 1.4m, 6m]
}

camera cam_follow {
  mode follow
  fov 45deg
  target actor person_c bone "head"
  offset [0m, 0.2m, -2m]
  shake 0.012m
  roll 0deg
}

timeline {
  # 脚步声与远处环境噪音贯穿长镜头
  cut 0s camera cam_follow
  play 0s actor person_c clip "walk" loop true blend 0.2s

  key 0s person_c.position [0m, 0m, 0m]
  key 10s person_c.position [0m, 0m, 12m] ease smoothstep
}
