shotdsl 0.1

scene noodle_shop_continuity {
  duration 11s
  fps 24
  seed 1280
  style storyboard
}

actor owner {
  model "storyboard-mannequin"
  position [-1m, 0m, -1m]
  rotation [0deg, 70deg, 0deg]
}

actor customer {
  model "storyboard-mannequin"
  position [4m, 0m, 1.6m]
  rotation [0deg, -90deg, 0deg]
}

actor cook {
  model "storyboard-mannequin"
  position [1.8m, 0m, -2.5m]
}

object counter {
  primitive box
  size [5m, 1m, 0.8m]
  position [0m, 0.5m, -1.8m]
}

object dining_table {
  primitive box
  size [2m, 0.75m, 1.2m]
  position [-2m, 0.75m, 2m]
}

object order_token {
  primitive cylinder
  radius 0.1m
  height 0.03m
  position [0m, 1.05m, -1.35m]
  rotation [90deg, 0deg, 0deg]
}

camera room_master {
  mode lookAt
  fov 44deg
  position [0m, 3m, 7.5m]
  target point [0m, 1m, 0m]
}

camera entrance {
  mode lookAt
  fov 38deg
  position [5.2m, 2m, 4m]
  target point [1.2m, 1m, -0.5m]
}

camera reverse_owner {
  mode lookAt
  fov 34deg
  position [-3.8m, 1.7m, 1.4m]
  target actor owner bone "head"
}

camera token_insert {
  mode lookAt
  fov 25deg
  position [0.8m, 1.45m, 0.2m]
  target object order_token
}

camera overhead {
  mode lookAt
  fov 48deg
  position [0m, 8.5m, 0.5m]
  target point [0m, 0m, 0m]
}

beat arrival {
  from 0s
  to 4s
  intent "顾客从入口走向柜台，保持由右向左的运动方向"
  focus actor customer
  continuity preserve
}

beat exchange {
  from 4s
  to 8.8s
  intent "用正反打和道具特写表达点单交接"
  focus object order_token
  continuity preserve
}

beat layout_check {
  from 8.8s
  to 11s
  intent "用俯视镜头检查前厅、柜台和后厨空间关系"
  focus point [0m, 0m, 0m]
  continuity preserve
}

timeline {
  cut 0s camera room_master
  note 0s "全景：顾客从画面右侧进入" duration 1.6s
  play 0s actor owner clip "idle" loop true
  play 0s actor cook clip "idle" loop true
  play 0s actor customer clip "walk" loop true
  key 0s customer.position [4m, 0m, 1.6m]
  key 3.7s customer.position [0.7m, 0m, -0.7m] ease smoothstep
  cut 1.8s camera entrance
  note 1.8s "保持运动方向：右 → 左" duration 1.8s

  cut 4s camera room_master
  play 3.7s actor customer clip "idle" loop true blend 0.16s
  gaze 3.8s actor owner target actor customer bone "head" duration 5s strength 0.7
  gaze 3.8s actor customer target actor owner bone "head" duration 5s strength 0.7
  play 4.1s actor customer clip "talk" loop true blend 0.12s
  cut 5.4s camera reverse_owner
  note 5.4s "反打：不要跨越人物视线轴" duration 1.8s
  play 5.5s actor owner clip "talk" loop true blend 0.12s

  cut 7s camera token_insert
  note 7s "道具交接特写，停留 1.3 秒" duration 1.3s
  play 7s actor owner clip "reach" loop false blend 0.12s
  ik 7s actor owner effector "hand_r" target object order_token weight 0.7 duration 0.8s
  key 7s order_token.position [0m, 1.05m, -1.35m]
  key 8.2s order_token.position [0.5m, 1.05m, -1.1m] ease smoothstep

  cut 8.8s camera overhead
  note 8.8s "俯视检查三块功能区的空间关系" duration 2.2s
  key 8.8s overhead.position [0m, 8.5m, 0.5m]
  key 11s overhead.position [0m, 9.5m, 1.4m] ease smoothstep
}
