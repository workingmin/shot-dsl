shotdsl 0.1

scene office_appointment_confrontation {
  duration 9s
  fps 30
  seed 5023
  style cinematic-outline
}

actor executive {
  model "generic_male_business"
  color ivory
  position [-1.15m, 0m, 0.4m]
  rotation [0deg, 90deg, 0deg]
}

actor employee {
  model "generic_female_business"
  color wheat
  position [1.15m, 0m, 0.4m]
  rotation [0deg, -90deg, 0deg]
}

object desk {
  primitive box
  size [1.5m, 0.76m, 0.9m]
  color #4b3a2b
  position [0m, 0.38m, 0.4m]
}

object appointment_letter {
  primitive box
  size [0.28m, 0.008m, 0.2m]
  color ivory
  position [0m, 0.77m, 0.4m]
  rotation [0deg, 12deg, 0deg]
}

object window_frame {
  primitive box
  size [3.2m, 2.3m, 0.1m]
  color #8aa0b0
  position [0m, 1.65m, -2.3m]
}

object rug {
  primitive box
  size [4m, 0.02m, 3m]
  color #4a5058
  position [0m, 0.01m, 0.4m]
}

camera master {
  mode lookAt
  fov 40deg
  position [0m, 2.15m, 4.8m]
  target point [0m, 1.05m, 0.4m]
}

camera over_executive {
  mode lookAt
  fov 34deg
  position [-0.72m, 1.55m, 1.55m]
  target actor employee bone "head"
  shake 0.003m
}

camera over_employee {
  mode lookAt
  fov 34deg
  position [0.72m, 1.55m, 1.55m]
  target actor executive bone "head"
  shake 0.003m
}

camera letter_insert {
  mode lookAt
  fov 27deg
  position [0.65m, 1.25m, 1.25m]
  target object appointment_letter
}

timeline {
  # 建立空间：两人隔桌相对，不跨越视线轴
  cut 0s camera master
  play 0s actor executive clip "idle" loop true
  play 0s actor employee clip "idle" loop true
  gaze 0s actor executive target actor employee bone "head" duration 9s strength 0.75
  gaze 0s actor employee target actor executive bone "head" duration 9s strength 0.75

  # 员工：“为什么？”
  cut 1.2s camera over_executive
  play 1.25s actor employee clip "talk" loop true blend 0.18s

  # 高管：“这是你的任命书。”
  cut 3.7s camera over_employee
  play 3.75s actor employee clip "idle" loop true blend 0.18s
  play 3.8s actor executive clip "talk" loop true blend 0.18s

  # 手伸向任命书，切物件特写而非无意义推拉
  cut 6s camera letter_insert
  play 6s actor executive clip "reach" loop false blend 0.14s

  # 回到双人关系镜头，轻微后撤结束
  cut 7.2s camera master
  play 7.2s actor executive clip "idle" loop true blend 0.18s
  key 7.2s master.position [0m, 2.15m, 4.8m]
  key 9s master.position [0m, 2.35m, 5.5m] ease smoothstep
}
